@page "/user-personal-letters"
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Services.PersonalLetterServices.GetPersonalLetterService getPersonalLetterService
@inject ResuMate.Services.PersonalLetterServices.DeletePersonalLetterService DeleteLetterService
@inject IJSRuntime JS

@attribute [Authorize]
@rendermode InteractiveServer

<link href="lib/bootstrap/dist/css/personalletter-gallery.css" rel="stylesheet" />

<div class="personal-letters-container">
    <div class="letters-header">
        <h3 class="section-title">Dina personliga brev</h3>
        <p class="letters-subtitle">Hantera och ladda ner dina sparade personliga brev</p>
        @if (generatedPersonalLetters?.Count > 0)
        {
            <div class="letters-count-badge">
                <span>📄</span>
                @generatedPersonalLetters.Count @(generatedPersonalLetters.Count == 1 ? "brev" : "brev")
            </div>
        }
    </div>

    @if (generatedPersonalLetters == null)
    {
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <p class="loading-text">Läser in dina personliga brev...</p>
        </div>
    }
    else if (generatedPersonalLetters.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">📝</div>
            <h4>Inga personliga brev än</h4>
            <p>Du har inga sparade personliga brev. Skapa ditt första personliga brev för att komma igång!</p>
            <a href="/personal-letter" class="btn-create-first">
                <span>✨</span>
                Skapa ditt första brev
            </a>
        </div>
    }
    else
    {
        <div class="letters-thumbnails">
            @foreach (var letter in generatedPersonalLetters)
            {
                <div class="letter-thumbnail-card">
                    <div class="letter-preview-container">
                        @if (!string.IsNullOrEmpty(letter.Base64CvData))
                        {
                            <iframe src="data:application/pdf;base64,@letter.Base64CvData"
                                    class="letter-preview-iframe"
                                    title="Förhandsvisning av @letter.FileName" />
                        }
                        else
                        {
                            <div class="no-preview">
                                <div class="no-preview-icon">📄</div>
                                <p class="no-preview-text">Ingen förhandsvisning tillgänglig</p>
                            </div>
                        }
                    </div>

                    <div class="letter-card-footer">                       

                        <div class="letter-meta">
                            <div class="letter-date">                                
                                📅 Skapad: <span>@letter.CreatedAt.ToString("dd/MM/yyyy")</span>
                            </div>                            
                        </div>

                        <div class="letter-actions">
                            <button class="btn-view-letter"
                                    @onclick="() => ViewLetter(letter)"
                                    title="Visa brev">                                
                                Visa brev
                            </button>

                            <button class="btn-download-letter"
                                    @onclick="() => DownloadLetter(letter)"
                                    title="Ladda ner brev">
                                <span class="btn-icon">⬇️</span>
                            </button>

                            <button class="btn-delete-letter"
                                    @onclick="() => ShowDeleteConfirmation(letter)"
                                    title="Ta bort brev">
                                <span class="btn-icon">🗑️</span>
                            </button>
                        </div>
                    </div>
                
                </div>
            }
        </div>
    }
    
    @if (showDeleteModal && letterToDelete != null)
    {
        <div class="delete-modal-overlay" @onclick="HideDeleteConfirmation">
            <div class="delete-modal" @onclick:stopPropagation="true">
                <h4>🗑️ Bekräfta borttagning</h4>
                <p>Är du säker på att du vill ta bort "<strong>@letterToDelete.FileName</strong>"?
                    Denna åtgärd kan inte ångras.</p>
                <div class="delete-modal-actions">
                    <button class="btn-modal-cancel" @onclick="HideDeleteConfirmation">
                        Avbryt
                    </button>
                    <button class="btn-modal-confirm" @onclick="ConfirmDeleteLetter">
                        Ta bort
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<GeneratedPersonalLetter>? generatedPersonalLetters;
    private bool showDeleteModal = false;
    private GeneratedPersonalLetter? letterToDelete = null;

    protected override async Task OnInitializedAsync()
    {
        var userId = await GetCurrentUserIdAsync();
        if (userId != null)
        {
            generatedPersonalLetters = await getPersonalLetterService.GetUserPersonalLettersAsync(userId);
        }
    }

    private void ViewLetter(GeneratedPersonalLetter letter)
    {
        JS.InvokeVoidAsync("viewPdf", letter.Base64CvData, letter.FileName);
    }

    private void DownloadLetter(GeneratedPersonalLetter letter)
    {
        JS.InvokeVoidAsync("downloadPdf", letter.Base64CvData, letter.FileName);
    }

    private void ShowDeleteConfirmation(GeneratedPersonalLetter letter)
    {
        letterToDelete = letter;
        showDeleteModal = true;
    }

    private void HideDeleteConfirmation()
    {
        showDeleteModal = false;
        letterToDelete = null;
    }

    private async Task ConfirmDeleteLetter()
    {
        if (letterToDelete != null)
        {
            await DeleteLetter(letterToDelete);
            HideDeleteConfirmation();
        }
    }

    private async Task DeleteLetter(GeneratedPersonalLetter letter)
    {
        var userId = await GetCurrentUserIdAsync();
        if (userId != null)
        {
            var success = await DeleteLetterService.DeleteLetterAsync(letter.Id, userId);
            if (success && generatedPersonalLetters != null)
            {
                generatedPersonalLetters.Remove(letter);
                StateHasChanged();
            }
        }
    }

    private async Task<string?> GetCurrentUserIdAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        return user.Identity?.IsAuthenticated == true
            ? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
            : null;
    }
}